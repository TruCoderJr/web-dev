<% layout( "/layouts/biolerplate") %>

<div class="container viewContainer">
  <%- include('../includes/flash') %>
  <div>
    <h2><%= details.title %></h2>
    <img
      class="viewListing"
      src="<%= details.image.url %>"
      alt="<%= details.image.title %>"
    />
    <h6><%= details.description %></h6>
    <% if (details.price != undefined) { %>
    <p class="card-text">
      &#x20B9;<%= details.price.toLocaleString("en-IN") %>/night
    </p>

    <% } %>
    <p><%= details.location %></p>
    <p><%= details.country %></p>

    <div class="viewFormDiv">
      <form action="/listings/<%= details._id %>/edit" method="GET">
        <button class="btn btn-primary" type="submit">Edit</button>
      </form>

      <form action="/listings/<%= details._id %>?_method=DELETE" method="POST">
        <!-- Add method override hidden input if needed for DELETE -->
        <button class="btn btn-danger" type="submit">Delete</button>
      </form>
    </div>
    <br />
    <hr />

    <div class="forReview mt-4">
      <h4 class="mb-3">User Reviews</h4>

      <% if (details.review && details.review.length) { %>
      <div class="row row-cols-1 g-4">
        <% for (let ele of details.review) { %>
        <div class="col mt-3">
          <div
            class="card shadow-sm border-primary p-2 d-flex flex-column justify-content-between"
            style="margin-bottom: 0"
          >
            <div class="card-body">
              <div class="pastedDate d-flex flex-row justify-content-between">
                <p
                  class="text-muted font-weight-light font-italic"
                  style="margin: 0"
                >
                  <i class="bi card-text bi-person-circle card-subtitle"
                    ><%= ele.userid %></i
                  >
                </p>
                <p
                  class="text-muted font-weight-light font-italic"
                  style="margin: 0"
                >
                  <i class="bi card-text bi-person-circle card-subtitle"
                    ><%= ele.createdAt.toString().split(" ")[2]%> <%=
                    ele.createdAt.toString().split(" ")[1]%> <%=
                    ele.createdAt.toString().split(" ")[3]%></i
                  >
                </p>
              </div>
              <p style="margin: 0"><%= ele.comment %></p>
            </div>
            <div class="bg-transparent">
              <p class="starability-result" data-rating="<%= ele.rating %>"
                >
              </p>
            </div>
            <form
              action="/listings/<%= details._id %>/reviews/<%= ele._id %>?_method=DELETE"
              method="post"
            >
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </div>
          <% } %>
        </div>
        <% } else { %>
        <p class="text-muted">No reviews yet. Be the first to leave one!</p>
        <% } %>
      </div>
      <br />
      <hr />

      <div>
        <h3 style="margin: 0; padding: 0; text-align: center">Leave Review:</h3>
        <form
          action="/listings/<%= details._id %>/reviews"
          method="POST"
          novalidate
          class="needs-validation"
        >
          <div class="mb-3 has-validation">
            <label for="userid" class="form-label">User id:</label>
            <input
              type="text"
              id="userid"
              name="review[userid]"
              class="form-control"
              placeholder="Enter your user id"
              required
            />
            <div class="invalid-feedback">Please choose a username.</div>
          </div>

          <div class="mb-3 has-validation">
            <label for="comment" class="form-label">Comments:</label>
            <textarea
              id="comment"
              name="review[comment]"
              rows="3"
              class="form-control"
              placeholder="leave a comment"
              required
            ></textarea>
            <div class="invalid-feedback">please leave some comment</div>
          </div>

          <div>
            <label for="rating" class="form-label">Give rating:</label>

            <fieldset class="starability-heart">
              <input
                type="radio"
                id="no-rate"
                class="input-no-rate"
                name="review[rating]"
                value="0"
                checked
                aria-label="No rating."
              />
              <input
                type="radio"
                id="second-rate1"
                name="review[rating]"
                value="1"
              />
              <label for="second-rate1" title="Terrible">1 star</label>
              <input
                type="radio"
                id="second-rate2"
                name="review[rating]"
                value="2"
              />
              <label for="second-rate2" title="Not good">2 stars</label>
              <input
                type="radio"
                id="second-rate3"
                name="review[rating]"
                value="3"
              />
              <label for="second-rate3" title="Average">3 stars</label>
              <input
                type="radio"
                id="second-rate4"
                name="review[rating]"
                value="4"
              />
              <label for="second-rate4" title="Very good">4 stars</label>
              <input
                type="radio"
                id="second-rate5"
                name="review[rating]"
                value="5"
              />
              <label for="second-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <button class="btn btn-info" type="submit">Submit</button>
        </form>
      </div>
    </div>
  </div>
</div>
